{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated author profile, free/pro tier status, and AI usage counter.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128,
          "description": "Firebase Authentication user UID"
        },
        "email": {
          "type": "string",
          "maxLength": 320,
          "description": "Verified user email address"
        },
        "displayName": {
          "type": "string",
          "maxLength": 120,
          "description": "Author display name"
        },
        "photoURL": {
          "type": "string",
          "maxLength": 500,
          "description": "Profile avatar URL"
        },
        "plan": {
          "type": "string",
          "enum": ["free", "pro"],
          "description": "Subscription tier"
        },
        "aiOrganizeCount": {
          "type": "integer",
          "description": "Number of AI dictation/refinement actions consumed"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp"
        }
      },
      "required": ["uid", "email", "plan", "aiOrganizeCount", "createdAt", "updatedAt"]
    },
    "BookRecord": {
      "title": "BookRecord",
      "description": "Cloud-persisted voice-dictated book owned by a single authenticated author.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128,
          "description": "Book document ID"
        },
        "ownerId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128,
          "description": "Owner user UID"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "Book title"
        },
        "subtitle": {
          "type": "string",
          "maxLength": 200,
          "description": "Optional subtitle"
        },
        "author": {
          "type": "string",
          "maxLength": 120,
          "description": "Author pen name"
        },
        "genre": {
          "type": "string",
          "maxLength": 80,
          "description": "Book genre"
        },
        "tone": {
          "type": "string",
          "maxLength": 100,
          "description": "Formatting style"
        },
        "synopsis": {
          "type": "string",
          "maxLength": 2000,
          "description": "Book synopsis"
        },
        "chapters": {
          "type": "array",
          "description": "Ordered chapters list (max 100)"
        },
        "characters": {
          "type": "array",
          "description": "Cast characters list (max 100)"
        },
        "timeline": {
          "type": "array",
          "description": "Chronological timeline events (max 200)"
        },
        "dictationHistory": {
          "type": "array",
          "description": "Raw dictation audit logs (max 200)"
        },
        "isDemo": {
          "type": "boolean",
          "description": "Whether this book is the read-only demo sample"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp"
        }
      },
      "required": [
        "id",
        "ownerId",
        "title",
        "author",
        "genre",
        "tone",
        "synopsis",
        "chapters",
        "characters",
        "timeline",
        "dictationHistory",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user profile, usage counter, and tier metadata."
    },
    "/users/{userId}/books/{bookId}": {
      "schema": { "$ref": "#/entities/BookRecord" },
      "description": "User-owned cloud books with chapters, characters, timeline, and dictation logs."
    }
  }
}
